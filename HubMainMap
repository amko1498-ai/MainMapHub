		if c:IsA("GuiObject") then c:Destroy() end
	end
end

local pos1, pos2, pos3
local function buildTP()
	clearScroll()
	for i = 1, 3 do
		local rf = Instance.new("Frame")
		rf.Size = UDim2.new(1, 0, 0, 28)
		rf.BackgroundTransparency = 1
		rf.Parent = scroll

		local rl = Instance.new("UIListLayout", rf)
		rl.FillDirection = Enum.FillDirection.Horizontal
		rl.Padding = UDim.new(0, 5)

		local s = mkB("Set Point " .. i, Color3.fromRGB(40, 80, 140))
		s.Size = UDim2.new(0.5, -3, 1, 0)
		s.Parent = rf

		local t = mkB("TP Point " .. i, Color3.fromRGB(40, 140, 80))
		t.Size = UDim2.new(0.5, -3, 1, 0)
		t.Parent = rf

		s.MouseButton1Click:Connect(function()
			local h = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if h then
				local cf = h.CFrame
				if i == 1 then pos1 = cf elseif i == 2 then pos2 = cf else pos3 = cf end
				s.Text = "Saved!"
				task.delay(1, function() s.Text = "Set Point " .. i end)
			end
		end)

		t.MouseButton1Click:Connect(function()
			local p = (i == 1 and pos1) or (i == 2 and pos2) or pos3
			local h = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if h and p then h.CFrame = p + Vector3.new(0, 3, 0) end
		end)
	end

	local ctp = mkB("Click TP Tool", Color3.fromRGB(140, 60, 140))
	ctp.Size = UDim2.new(1, 0, 0, 28)
	ctp.Parent = scroll
	ctp.MouseButton1Click:Connect(function()
		if plr.Backpack:FindFirstChild("Click TP") or (plr.Character and plr.Character:FindFirstChild("Click TP")) then return end
		local tool = Instance.new("Tool")
		tool.Name = "Click TP"
		tool.RequiresHandle = false
		tool.CanBeDropped = false
		tool.Parent = plr.Backpack
		tool.Activated:Connect(function()
			local mouse = plr:GetMouse()
			local h = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if h and mouse.Target then h.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)) end
		end)
	end)
end

local espOn = false
local espHl = {}
local espConns = {}
local wallOn = false
local wallConn
local infOn = false
local infConn
local spdOn = false
local spdConn

local function addHl(ch, p)
	if not espOn then return end
	if espHl[p] then espHl[p]:Destroy() end
	local h = Instance.new("Highlight")
	h.FillColor = Color3.fromRGB(255, 0, 0)
	h.OutlineColor = Color3.fromRGB(255, 100, 100)
	h.Parent = ch
	espHl[p] = h
end

local function setESP(on)
	espOn = on
	if on then
		for _, p in ipairs(game.Players:GetPlayers()) do
			if p ~= plr then
				if p.Character then addHl(p.Character, p) end
				table.insert(espConns, p.CharacterAdded:Connect(function(ch) task.wait(0.1) addHl(ch, p) end))
			end
		end
		table.insert(espConns, game.Players.PlayerAdded:Connect(function(p)
			if p == plr then return end
			if p.Character then addHl(p.Character, p) end
			table.insert(espConns, p.CharacterAdded:Connect(function(ch) task.wait(0.1) addHl(ch, p) end))
		end))
	else
		for _, c in ipairs(espConns) do c:Disconnect() end
		espConns = {}
		for _, h in pairs(espHl) do h:Destroy() end
		espHl = {}
	end
end

local function setWall(on)
	if on then
		if wallConn then return end
		wallConn = RS.Stepped:Connect(function()
			local ch = plr.Character
			if ch then
				for _, n in ipairs({"Head", "Torso", "UpperTorso", "LowerTorso", "HumanoidRootPart"}) do
					local pt = ch:FindFirstChild(n)
					if pt then pt.CanCollide = false end
				end
			end
		end)
	else
		if wallConn then wallConn:Disconnect() wallConn = nil end
		local ch = plr.Character
		if ch then
			for _, n in ipairs({"Head", "Torso", "UpperTorso", "LowerTorso", "HumanoidRootPart"}) do
				local pt = ch:FindFirstChild(n)
				if pt then pt.CanCollide = (n ~= "Head" and n ~= "HumanoidRootPart") end
			end
		end
	end
end

local function setInf(on)
	if on then
		if infConn then return end
		infConn = UIS.JumpRequest:Connect(function()
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end)
	else
		if infConn then infConn:Disconnect() infConn = nil end
	end
end

local function setSpd(on)
	if on then
		if spdConn then return end
		spdConn = RS.Stepped:Connect(function()
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.WalkSpeed ~= 32 then hum.WalkSpeed = 32 end
		end)
	else
		if spdConn then spdConn:Disconnect() spdConn = nil end
		local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 16 end
	end
end

