local function overBtn(x, y)
	for _, o in ipairs(UIS:GetGuiObjectsAtPosition(x, y)) do
		if o == lk or o == cl or o:IsDescendantOf(lk) or o:IsDescendantOf(cl) then
			return true
		end
	end
	return false
end

UIS.InputBegan:Connect(function(input)
	if isLocked then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local pos = input.Position
	local ap = main.AbsolutePosition
	local asz = main.AbsoluteSize
	local hh = hdr.AbsoluteSize.Y
	if pos.X < ap.X or pos.X > ap.X + asz.X or pos.Y < ap.Y or pos.Y > ap.Y + hh then return end
	if overBtn(pos.X, pos.Y) then return end
	dragging = true
	dragStart = Vector2.new(pos.X, pos.Y)
	startPos = main.Position
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local pos = input.Position
	local d = Vector2.new(pos.X, pos.Y) - dragStart
	main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)
